[Unit]
Description=remoteplayer: records the mpv playback state
After=remoteplayer-mpv.service

[Service]
Type=notify
# Same user as remoteplayer-mpv.service: its IPC socket is private to that user.
User=coop
# /var/lib/remoteplayer-mpvwatcher/state.json
StateDirectory=remoteplayer-mpvwatcher
StateDirectoryMode=0750
# /run/remoteplayer-mpvwatcher/state.sock
RuntimeDirectory=remoteplayer-mpvwatcher
RuntimeDirectoryMode=0700
UMask=0077
ExecStart=/usr/local/bin/remoteplayer-mpvwatcher --config /etc/remoteplayer/mpvwatcher.toml
Restart=always
RestartSec=2
# The watcher pings systemd after every poll; if it hangs, systemd restarts it.
WatchdogSec=60

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
